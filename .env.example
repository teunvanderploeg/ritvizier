BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty for the in-memory cache. Set a PostgreSQL URL for durable storage.
DATABASE_URL=
# Set this to your own PostgreSQL connection string when using a database.
# Required only for Docker Compose; use a random URL-safe hex password.
POSTGRES_PASSWORD=
CACHE_TTL_SECONDS=21600
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
# Optional server-only SODA application token. Never use NEXT_PUBLIC_ for this value.
RDW_APP_TOKEN=
RDW_TIMEOUT_SECONDS=8
APK_NOTICE_DAYS=60
APK_URGENT_DAYS=30
RECENT_REGISTRATION_DAYS=30
# Optional server-only path to a current authorized Dutch listing JSON snapshot.
# No paid API is used. See docs/listing-search.md for free export imports.
LISTINGS_FILE=

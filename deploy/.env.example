# Copy to /opt/ritvizier/.env on the VPS. Do not commit the actual file.
SITE_URL=https://ritvizier.example.nl
# Generate using: openssl rand -hex 32 (URL-safe, no escaping required).
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
HTTP_PORT=3000
# This is a shared backend bucket behind Next.js, not a per-visitor limit.
RATE_LIMIT_PER_MINUTE=300
RDW_APP_TOKEN=
